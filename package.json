{
    "name": "iobroker.vis-colorpicker",
    "description": "Color picker widgets for ioBroker.vis and ioBroker.vis-2",
    "version": "2.1.0",
    "author": {
        "name": "bluefox",
        "email": "dogafox@gmail.com"
    },
    "contributors": [
        "bluefox <dogafox@gmail.com>",
        "hobbyquaker <hq@ccu.io>",
        "pmant <patrickmo@gmx.de>",
        "oweitman <oweitman@gmx.de>"
    ],
    "homepage": "https://github.com/ioBroker/ioBroker.vis-colorpicker",
    "repository": {
        "type": "git",
        "url": "https://github.com/ioBroker/ioBroker.vis-colorpicker"
    },
    "keywords": [
        "ioBroker",
        "GUI",
        "DashUI",
        "web interface",
        "home automation",
        "SCADA",
        "colorpicker",
        "vis",
        "vis-2"
    ],
    "devDependencies": {
        "@alcalzone/release-script": "^5.2.1",
        "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
        "@alcalzone/release-script-plugin-license": "^5.2.2",
        "@iobroker/build-tools": "^3.0.3",
        "@iobroker/eslint-config": "^2.3.4",
        "@iobroker/testing": "^6.2.2",
        "mocha": "^12.0.0"
    },
    "bugs": {
        "url": "https://github.com/ioBroker/ioBroker.vis-colorpicker/issues"
    },
    "main": "widgets/colorpicker.html",
    "files": [
        "admin/",
        "img/",
        "widgets/",
        "io-package.json",
        "LICENSE"
    ],
    "scripts": {
        "prepublishOnly": "npm run build",
        "build": "node tasks",
        "copy-files": "node tasks --copy-files",
        "tsc": "cd src-widgets && npx tsc",
        "check-widgets": "cd src-widgets && node checkWidgets.mjs",
        "preview": "cd src-widgets && npm run preview",
        "screenshots": "cd src-widgets && node preview/screenshots.mjs",
        "lint": "eslint -c eslint.config.mjs",
        "test": "mocha --exit",
        "test:package": "mocha test/testPackageFiles --exit",
        "npm": "npm i && cd src-widgets && npm i",
        "update-packages": "npx -y npm-check-updates --upgrade && cd src-widgets && npx -y npm-check-updates --upgrade",
        "release": "release-script",
        "release-patch": "release-script patch --yes --no-update-lockfile",
        "release-minor": "release-script minor --yes --no-update-lockfile",
        "release-major": "release-script major --yes --no-update-lockfile"
    },
    "license": "MIT"
}
